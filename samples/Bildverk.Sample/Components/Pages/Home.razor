@page "/"
@using Bildverk.Security
@inject IBildverkUrlSigner Signer

<PageTitle>Bildverk sample</PageTitle>

<h1>Bildverk</h1>
<p>Every image below is the same 2400×1600 original, <code>/images/landscape.jpg</code>, resized on request and cached on disk.</p>

<div class="grid">
    @foreach (var (label, query) in Examples)
    {
        var url = Signer.Sign($"/images/landscape.jpg?{query}");
        <figure>
            <img src="@url" alt="@label" loading="lazy" />
            <figcaption><strong>@label</strong><br /><code>?@query</code></figcaption>
        </figure>
    }
</div>

@code {
    private static readonly (string Label, string Query)[] Examples =
    [
        ("Hero banner (crop)", "width=1920&height=600&rmode=crop&quality=80"),
        ("Fit inside box (max)", "width=400&height=400"),
        ("Square crop, focal point on the sun", "width=300&height=300&rmode=crop&rxy=0.71,0.28"),
        ("Square crop, bottom anchor", "width=300&height=300&rmode=crop&ranchor=bottom"),
        ("Pad to square", "width=300&height=300&rmode=pad&bgcolor=f1f1f1"),
        ("Auto format (AVIF/WebP/JPEG by browser)", "width=600&format=auto"),
        ("WebP, low quality", "width=600&format=webp&quality=40"),
        ("AVIF", "width=600&format=avif&quality=60"),
        ("Stretch", "width=300&height=300&rmode=stretch"),
    ];
}
