{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Bildverk": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Bildverk": {
    "Cache": {
      "Path": "App_Data/bildverk-cache",
      "FolderDepth": 2,
      "HashLength": 16,
      "MaxAge": "365.00:00:00",
      "MaxSizeMB": 2000,
      "CleanupInterval": "01:00:00"
    },
    "Browser": {
      "MaxAge": "7.00:00:00"
    },
    "Limits": {
      "MaxWidth": 4000,
      "MaxHeight": 4000,
      "MaxSourcePixels": 100000000,
      "MaxConcurrentProcessing": 4
    },
    "Defaults": {
      "Quality": 80,
      "ProgressiveJpeg": true,
      "WebpEffort": 0,
      "AvifEffort": 0
    },
    "Security": {
      "HmacKey": null
    },
    "Formats": {
      "AutoByDefault": true,
      "AutoForPlainRequests": false,
      "Preference": [
        "avif",
        "webp"
      ]
    },
    "Optimize": {
      "Enabled": true,
      "WebpEffort": 6,
      "AvifEffort": 4,
      "MaxConcurrent": 1,
      "QueueLimit": 10000,
      "MinSavingsPercent": 1
    },
    "Masters": {
      "Enabled": true,
      "Size": 2560,
      "Quality": 95,
      "MinSourceBytes": 1500000
    }
  }
}